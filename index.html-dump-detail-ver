    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;

            background: #f7f4ef;

            color: #1d1d1d;
        }


        /* ========================================
           NAVBAR
        ======================================== */

        .navbar {

            position: sticky;

            top: 0;

            z-index: 1000;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 18px 7%;

            background: rgba(
                255,
                255,
                255,
                0.96
            );

            border-bottom: 1px solid #eee;

            backdrop-filter: blur(10px);
        }

        .brand {

            font-size: 18px;

            font-weight: 800;

            color: #1d1d1d;

            text-decoration: none;
        }

        .nav-links {

            display: flex;

            align-items: center;

            gap: 28px;

            list-style: none;
        }

        .nav-links a {

            color: #555;

            font-size: 14px;

            text-decoration: none;

            transition: 0.2s ease;
        }

        .nav-links a:hover {

            color: #111;
        }

        .nav-login {

            padding: 10px 16px;

            border-radius: 8px;

            background: #1d1d1d;

            color: #fff !important;
        }


        /* ========================================
           HERO
        ======================================== */

        .hero {

            min-height: calc(100vh - 75px);

            padding: 80px 7%;

            display: grid;

            grid-template-columns:
                1fr 0.9fr;

            align-items: center;

            gap: 70px;

            background:
                radial-gradient(
                    circle at 80% 20%,
                    #ffe6ca 0,
                    transparent 32%
                );
        }

        .hero-label {

            display: inline-block;

            margin-bottom: 18px;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 3px;

            color: #999;
        }

        .hero-content h1 {

            margin-bottom: 22px;

            font-size:
                clamp(48px, 6vw, 82px);

            line-height: 0.95;

            letter-spacing: -3px;
        }

        .hero-content h1 span {

            color: #777;
        }

        .hero-content > p {

            max-width: 570px;

            margin-bottom: 30px;

            font-size: 16px;

            line-height: 1.8;

            color: #666;
        }

        .hero-buttons {

            display: flex;

            align-items: center;

            gap: 12px;

            flex-wrap: wrap;
        }

        .btn-primary,
        .btn-secondary {

            display: inline-block;

            padding: 13px 20px;

            border-radius: 8px;

            font-size: 14px;

            font-weight: 700;

            text-decoration: none;

            transition:
                transform 0.2s ease,
                background 0.2s ease;
        }

        .btn-primary {

            background: #1d1d1d;

            color: #fff;
        }

        .btn-primary:hover {

            background: #333;

            transform:
                translateY(-2px);
        }

        .btn-secondary {

            border: 1px solid #ddd;

            background: #fff;

            color: #222;
        }

        .btn-secondary:hover {

            transform:
                translateY(-2px);
        }


        /* ========================================
           HERO IMAGE
        ======================================== */

        .hero-image {

            position: relative;

            width: 100%;
        }

        .image-frame {

            width: 100%;

            height: 600px;

            overflow: hidden;

            border-radius: 4px;
        }

        .image-frame img {

            display: block;

            width: 100%;

            height: 100%;

            object-fit: cover;

            object-position: center;
        }

        .hero-card {

            position: absolute;

            right: -20px;

            bottom: 30px;

            padding: 20px 24px;

            background: #fff;

            box-shadow:
                0 15px 40px
                rgba(0, 0, 0, 0.12);
        }

        .hero-card strong {

            display: block;

            margin-bottom: 4px;

            font-size: 28px;
        }

        .hero-card span {

            font-size: 12px;

            color: #777;
        }


        /* ========================================
           SECTION
        ======================================== */

        .section {

            padding: 90px 7%;
        }

        .section-header {

            display: flex;

            align-items: end;

            justify-content: space-between;

            gap: 30px;

            margin-bottom: 45px;
        }

        .section-label {

            display: block;

            margin-bottom: 8px;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 3px;

            color: #999;
        }

        .section-title {

            font-size: 40px;

            line-height: 1.1;
        }

        .section-description {

            max-width: 550px;

            font-size: 14px;

            line-height: 1.7;

            color: #777;
        }


        /* ========================================
           EKSTRA GRID
        ======================================== */

        .ekstra-grid {

            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            gap: 22px;
        }

        .ekstra-card {

            position: relative;

            overflow: hidden;

            padding: 28px;

            min-height: 330px;

            display: flex;

            flex-direction: column;

            background: #fff;

            border: 1px solid #eee;

            border-radius: 16px;

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .ekstra-card:hover {

            transform:
                translateY(-5px);

            box-shadow:
                0 18px 45px
                rgba(0, 0, 0, 0.08);
        }

        .ekstra-logo {

            width: 90px;

            height: 90px;

            margin-bottom: 22px;

            display: flex;

            align-items: center;

            justify-content: center;
        }

        .ekstra-logo img {

            width: 100%;

            height: 100%;

            object-fit: contain;
        }

        .ekstra-category {

            display: inline-block;

            margin-bottom: 8px;

            font-size: 10px;

            font-weight: 700;

            letter-spacing: 2px;

            text-transform: uppercase;

            color: #999;
        }

        .ekstra-card h3 {

            margin-bottom: 10px;

            font-size: 22px;
        }

        .ekstra-card p {

            margin-bottom: 22px;

            font-size: 14px;

            line-height: 1.7;

            color: #777;
        }

        .detail-button {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            width: fit-content;

            margin-top: auto;

            padding: 11px 17px;

            border-radius: 8px;

            background: #1d1d1d;

            color: #fff;

            font-size: 13px;

            font-weight: 700;

            text-decoration: none;

            transition:
                background 0.2s ease,
                transform 0.2s ease;
        }

        .detail-button:hover {

            background: #333;

            transform:
                translateY(-2px);
        }


        /* ========================================
           FOOTER
        ======================================== */

        footer {

            padding: 40px 7%;

            background: #1d1d1d;

            color: #aaa;

            text-align: center;

            font-size: 13px;
        }


        /* ========================================
           MOBILE
        ======================================== */

        @media (max-width: 900px) {

            .hero {

                grid-template-columns: 1fr;

            }

            .hero-image {

                max-width: 700px;

                margin: 0 auto;

            }

            .ekstra-grid {

                grid-template-columns:
                    repeat(2, minmax(0, 1fr));

            }

        }


        @media (max-width: 600px) {

            .navbar {

                padding:
                    16px 5%;
            }

            .nav-links {

                display: none;
            }

            .hero {

                min-height: auto;

                padding:
                    60px 5%;

                gap: 40px;
            }

            .hero-content h1 {

                font-size: 48px;

                letter-spacing: -2px;
            }

            .image-frame {

                height: 480px;
            }

            .hero-card {

                right: 15px;

                bottom: 20px;
            }

            .section {

                padding:
                    65px 5%;
            }

            .section-header {

                display: block;
            }

            .section-title {

                font-size: 32px;

                margin-bottom: 12px;
            }

            .ekstra-grid {

                grid-template-columns: 1fr;
            }

            .ekstra-card {

                min-height: 300px;
            }

        }

    </style>

</head>


